FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-core fonts-noto-extra && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY render-server/package.json ./package.json
RUN npm install --omit=dev
COPY render-server/server.js ./server.js
ENV PORT=8080
EXPOSE 8080
CMD ["node","server.js"]