{
  "name":"afd-dj-windows",
  "version":"1.5.5",
  "description":"AFD DJ Windows Desktop",
  "main":"main-v205.js",
  "author":"AFD DJ",
  "license":"UNLICENSED",
  "scripts":{"start":"electron .","dist":"electron-builder --win nsis --publish never"},
  "dependencies":{"ffmpeg-static":"^5.2.0","music-tempo":"^1.0.3","signalsmith-stretch":"^1.3.2"},
  "devDependencies":{"electron":"^37.2.6","electron-builder":"^26.0.12"},
  "build":{
    "appId":"com.afd.dj",
    "productName":"AFD DJ",
    "artifactName":"AFD-DJ-Windows-Setup-${version}-${arch}.${ext}",
    "asarUnpack":["node_modules/ffmpeg-static/**","node_modules/music-tempo/**"],
    "win":{"target":["nsis"]},
    "nsis":{
      "oneClick":false,
      "allowToChangeInstallationDirectory":true,
      "createDesktopShortcut":true,
      "createStartMenuShortcut":true,
      "shortcutName":"AFD DJ",
      "deleteAppDataOnUninstall":false
    }
  }
}
