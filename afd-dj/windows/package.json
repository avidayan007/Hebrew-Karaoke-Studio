{
  "name":"afd-dj-windows",
  "version":"1.2.9",
  "description":"AFD DJ Windows Desktop",
  "main":"main.js",
  "author":"AFD DJ",
  "license":"UNLICENSED",
  "scripts":{"start":"electron .","dist":"electron-builder --win nsis --publish never"},
  "devDependencies":{"electron":"^37.2.6","electron-builder":"^26.0.12"},
  "build":{
    "appId":"com.afd.dj",
    "productName":"AFD DJ",
    "artifactName":"AFD-DJ-Windows-Setup-${version}-${arch}.${ext}",
    "win":{"target":["nsis"]},
    "nsis":{
      "oneClick":false,
      "allowToChangeInstallationDirectory":true,
      "createDesktopShortcut":true,
      "createStartMenuShortcut":true,
      "shortcutName":"AFD DJ",
      "deleteAppDataOnUninstall":false
    }
  }
}
